      "name": "Fetch Website HTML",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Process each incoming item\nreturn items.map(item => {\n\n  let html = item.json.data || \"\";\n\n  // Remove unwanted elements\n  html = html\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, \"\")\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, \"\")\n    .replace(/<svg[\\s\\S]*?<\\/svg>/gi, \"\")\n    .replace(/<noscript[\\s\\S]*?<\\/noscript>/gi, \"\")\n    .replace(/<iframe[\\s\\S]*?<\\/iframe>/gi, \"\")\n    .replace(/<!--[\\s\\S]*?-->/g, \"\");\n\n  // Strip HTML tags\n  let text = html.replace(/<[^>]+>/g, \"\\n\");\n\n  // Decode common HTML entities\n  text = text\n    .replace(/&nbsp;/g, \" \")\n    .replace(/&amp;/g, \"&\")\n    .replace(/&lt;/g, \"<\")\n    .replace(/&gt;/g, \">\")\n    .replace(/&quot;/g, '\"')\n    .replace(/&#39;/g, \"'\")\n    .replace(/&#x27;/g, \"'\");\n\n  // Split into lines\n  let lines = text\n    .split(\"\\n\")\n    .map(line => line.trim())\n    .filter(line => line.length > 2);\n\n  // Remove duplicate lines\n  lines = [...new Set(lines)];\n\n  // Remove noisy/repeated content\n  const blacklist = [\n    \"Skip to main content\",\n    \"Log in\",\n    \"Login\",\n    \"Download app\",\n    \"Cookie\",\n    \"Cookies\",\n    \"Privacy Policy\",\n    \"Terms of Use\",\n    \"Terms & Policies\",\n    \"Manage Cookies\",\n    \"Accept all cookies\",\n    \"Reject all cookies\",\n    \"Necessary\",\n    \"Analytics\",\n    \"Marketing\",\n    \"English\",\n    \"United States\"\n  ];\n\n  lines = lines.filter(line => {\n    return !blacklist.some(word =>\n      line.toLowerCase().includes(word.toLowerCase())\n    );\n  });\n\n  // Join back together\n  text = lines.join(\"\\n\");\n\n  // Normalize whitespace\n  text = text\n    .replace(/\\n{2,}/g, \"\\n\")\n    .replace(/[ \\t]{2,}/g, \" \")\n    .trim();\n\n  // Limit by words instead of characters\n  const MAX_WORDS = 1500;\n\n  const words = text.split(/\\s+/);\n\n  if (words.length > MAX_WORDS) {\n    text = words.slice(0, MAX_WORDS).join(\" \");\n  }\n\n  return {\n    json: {\n      company: item.json.Company,\n      website: item.json.Website,\n      scraped_at: new Date().toISOString(),\n      content: text\n    }\n  };\n\n});"
      },
