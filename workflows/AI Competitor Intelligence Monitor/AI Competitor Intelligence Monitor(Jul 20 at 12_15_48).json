      "id": "3054511f-f046-41ca-8400-03561fd1bef9",
      "name": "Clean Website Content"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Website Content:\n\n{{ $json.content }}",
        "options": {
          "systemMessage": "You are an expert Competitive Intelligence Analyst.\n\nYour task is to analyze a competitor's website content and extract ONLY meaningful business information.\n\nIMPORTANT:\n\nOnly extract information that explicitly exists in the provided website content.\n\nDo NOT use your prior knowledge.\n\nDo NOT infer missing information.\n\nIf a field is not present, return an empty array or empty string.\n\nNever hallucinate.\nIgnore:\n- Navigation menus\n- Footer links\n- Login buttons\n- Cookie notices\n- Privacy policies\n- Terms of service\n- Duplicate text\n\nExtract only:\n\n- Company Name\n- Website Title\n- Products\n- Services\n- Pricing Information\n- New Features\n- Latest Announcements\n- Latest News\n- Research Updates\n- Career Opportunities\n- Calls To Action\n\nReturn ONLY valid JSON.\n\n{\n  \"company\": \"\",\n  \"title\": \"\",\n  \"products\": [],\n  \"services\": [],\n  \"pricing\": [],\n  \"features\": [],\n  \"announcements\": [],\n  \"news\": [],\n  \"research\": [],\n  \"careers\": [],\n  \"cta\": [],\n  \"summary\": \"\"\n}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        400,
        16
      ],
      "id": "7bd4d8a3-9110-4ec3-a77b-85fb8825d3d0",
      "name": "Extract Competitor Snapshot"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n\n  let output = item.json.output || \"\";\n\n  output = output\n    .replace(/```json/gi, \"\")\n    .replace(/```/g, \"\")\n    .trim();\n\n  let extracted;\n\n  try {\n    extracted = JSON.parse(output);\n  } catch (e) {\n    throw new Error(`Invalid JSON returned by AI:\\n${output}`);\n  }\n\n  return {\n    json: extracted\n  };\n\n});"
      },
