      "parameters": {
        "jsCode": "const history = [];\n\nfor (const item of items) {\n  if (item.json.role && item.json.messages) {\n    history.push(`${item.json.role}: ${item.json.messages}`);\n  }\n}\n\nreturn [\n  {\n    json: {\n      conversationId: $('Extract Request Data').first().json.conversationId,\n      message: $('Extract Request Data').first().json.message,\n      timestamp: $('Extract Request Data').first().json.timestamp,\n      history: history.join('\\n')\n    }\n  }\n];"
      },
